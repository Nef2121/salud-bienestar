rules_version = '2';

// Los otros módulos agregan sus colecciones (actividad, foro, etc.) debajo de la
// de "users", siempre exigiendo sesión iniciada. Lo que no esté permitido
// explícitamente queda denegado.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function rolDe(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.rol;
    }

    function esAdmin() {
      return autenticado() && rolDe(request.auth.uid) == 'admin';
    }

    function esModerador() {
      return autenticado() && rolDe(request.auth.uid) in ['admin', 'moderador'];
    }

    // Campos legibles del perfil (mismos rangos que src/utils/validators.js).
    // DUI, tipo de sangre, teléfono del encargado, peso y altura viajan cifrados
    // dentro de `cifrado` (AES-256-GCM): el servidor no puede validarlos, por eso
    // esas validaciones las hace la app (validators.js) antes de cifrar.
    function perfilValido(d) {
      return d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 60
        && d.correo is string && d.correo.size() <= 100
        && d.edad is int && d.edad >= 12 && d.edad <= 100
        && d.sexo in ['Masculino', 'Femenino', 'Otro', 'Prefiero no decir']
        && d.objetivos is list && d.objetivos.size() >= 1 && d.objetivos.size() <= 6
        && d.cifrado is string && d.cifrado.size() >= 30 && d.cifrado.size() <= 4000
        && d.cifrado.matches('^v1[.].*');
    }

    match /users/{uid} {
      // Cada usuario lee solo su perfil; un admin puede leer cualquiera
      // (pero no puede descifrarlo: no tiene acceso a la clave, ver más abajo).
      allow read: if esDueno(uid) || esAdmin();

      // Al registrarse, el rol siempre es 'usuario' ojo: nadie se crea como admin.
      allow create: if esDueno(uid)
        && request.resource.data.rol == 'usuario'
        && perfilValido(request.resource.data);

      allow update: if perfilValido(request.resource.data)
        && (
          // El usuario edita su perfil: no puede cambiar su rol ni su correo.
          (esDueno(uid)
            && request.resource.data.rol == resource.data.rol
            && request.resource.data.correo == resource.data.correo)
          // Un admin solo puede cambiar el rol de OTRO usuario, y solo entre
          // 'usuario' y 'moderador'. Los admins se nombran a mano en la consola.
          || (esAdmin()
            && uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol'])
            && resource.data.rol in ['usuario', 'moderador']
            && request.resource.data.rol in ['usuario', 'moderador'])
        );

      allow delete: if false;

      // Planificación: contenido cifrado; acceso exclusivo del dueño.
      match /{modulo}/{registro} {
        allow read, delete: if esDueno(uid) && modulo in ['objetivos','recordatorios','comidas'];
        allow create, update: if esDueno(uid) && modulo in ['objetivos','recordatorios','comidas']
          && request.resource.data.keys().hasOnly(['cifrado','actualizado'])
          && request.resource.data.cifrado is string
          && request.resource.data.cifrado.size() >= 30
          && request.resource.data.cifrado.size() <= 12000
          && request.resource.data.cifrado.matches('^v1[.].*')
          && request.resource.data.actualizado == request.time;
      }
      match /dispositivos/{dispositivo} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && request.resource.data.keys().hasOnly(['token','plataforma','actualizado'])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.plataforma == 'android'
          && request.resource.data.actualizado == request.time;
      }

      // Clave de cifrado del usuario: solo su dueño puede leerla o crearla (una vez).
      // Ni los admins ni nadie más tiene acceso. No se puede cambiar ni borrar,
      // porque dejaría sus datos cifrados ilegibles.
      match /privado/clave {
        allow get, create: if esDueno(uid);
        allow list, update, delete: if false;
      }

      // Registros de actividad física
      match /actividades_fisicas/{actividadId} {
        allow read: if esDueno(uid);

        allow create, update: if esDueno(uid)
          && request.resource.data.keys().hasAll([
            'uid',
            'fecha',
            'pasos',
            'distancia',
            'calorias',
            'sincronizado_en'
          ])
          && request.resource.data.keys().hasOnly([
            'uid',
            'fecha',
            'pasos',
            'distancia',
            'calorias',
            'sincronizado_en'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.fecha is string
          && request.resource.data.pasos is int
          && request.resource.data.pasos >= 0
          && request.resource.data.distancia is number
          && request.resource.data.distancia >= 0
          && request.resource.data.calorias is int
          && request.resource.data.calorias >= 0
          && request.resource.data.sincronizado_en is timestamp;
    }

      // Registros de entrenamientos
      match /entrenamientos/{entrenamientoId} {
        allow read: if esDueno(uid);

        allow create, update: if esDueno(uid)
          && request.resource.data.keys().hasAll([
            'uid',
            'fecha',
            'tipo',
            'duracion_min',
            'intensidad',
            'calorias',
            'sincronizado_en'
          ])
          && request.resource.data.keys().hasOnly([
            'uid',
            'fecha',
            'tipo',
            'duracion_min',
            'intensidad',
            'calorias',
            'sincronizado_en'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.fecha is string
          && request.resource.data.tipo is string
          && request.resource.data.duracion_min is int
          && request.resource.data.duracion_min > 0
          && request.resource.data.intensidad in ['Baja', 'Media', 'Alta']
          && request.resource.data.calorias is int
          && request.resource.data.calorias >= 0
          && request.resource.data.sincronizado_en is timestamp;
    }
    }
  }
}
